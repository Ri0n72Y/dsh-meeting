{
  "name": "@ri0n72y/dsh-meeting-speaker",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --no-fixed-extension --out-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "sherpa-onnx-node": ">=1.13.8"
  },
  "peerDependenciesMeta": {
    "sherpa-onnx-node": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  }
}
