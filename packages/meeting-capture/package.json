{
  "name": "@ri0n72y/dsh-meeting-capture",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "development": "./src/browser.ts",
      "types": "./dist/client/browser.d.ts",
      "default": "./dist/client/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir dist && tsdown src/browser.ts --format esm --dts --out-dir dist/client",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-experimental-speech-to-text": "0.2.0-rc.2",
    "@ri0n72y/dsh-meeting-context": "workspace:*",
    "@ri0n72y/dsh-meeting-speaker": "workspace:*",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@ri0n72y/dsh-meeting-speaker": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "optionalDependencies": {
    "loopback-capture": "3.0.2"
  }
}
