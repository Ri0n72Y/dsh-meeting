{
  "name": "dsh-meeting-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build && pnpm run check:client",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "pnpm -r --filter './packages/**' run typecheck && tsc -p tsconfig.json --noEmit",
    "check:client": "node scripts/check-meeting-client.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsx": "^4.20.0",
    "tsdown": "^0.22.2",
    "@types/node": "^24.0.0",
    "lightningcss": "^1.33.0"
  }
}
