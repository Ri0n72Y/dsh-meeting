{
  "name": "@ri0n72y/dsh-meeting",
  "version": "0.0.3",
  "description": "Windows system-audio meeting capture, SenseVoice transcription and Sidebar summaries for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ri0n72Y/dsh-meeting.git"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client/index.js"
    },
    "./context": {
      "types": "./lib/context/index.d.ts",
      "default": "./lib/context/index.js"
    },
    "./capture": {
      "types": "./lib/capture/index.d.ts",
      "default": "./lib/capture/index.js"
    },
    "./speaker": {
      "types": "./lib/speaker/index.d.ts",
      "default": "./lib/speaker/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "native/CMakeLists.txt",
    "native/package.json",
    "native/src/**",
    "native/LICENSE",
    "native/README.md",
    "native/build/Release/*.node",
    "scripts/build-native.mjs"
  ],
  "scripts": {
    "build": "node scripts/clean-lib.mjs && tsdown --config tsdown.host.config.mjs && tsdown --config tsdown.client.config.mjs && npm run check:client && npm run check:install",
    "native:build": "node scripts/build-native.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:client": "node scripts/check-meeting-client.mjs",
    "check:install": "node scripts/check-installable.mjs",
    "check:prebuilt": "node scripts/check-committed-lib.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-experimental-speech-to-text": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-rc.3",
    "react": "^18.2.0",
    "sherpa-onnx-node": ">=1.13.8"
  },
  "peerDependenciesMeta": {
    "sherpa-onnx-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsx": "^4.20.0",
    "tsdown": "^0.22.2",
    "@types/node": "^24.0.0",
    "lightningcss": "^1.33.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-experimental-speech-to-text": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/cordis-plugin-include": "1.0.10",
      "@deepseek-ai/cordis-plugin-loader": "1.0.6"
    }
  }
}
